# Copie este arquivo para .env.local e preencha os valores:
#   cp .env.example .env.local

# URL da API NestJS — dentro do container Docker use host.docker.internal
# Exemplo Docker (stacks separadas): http://host.docker.internal:3000
API_URL=http://host.docker.internal:3000

# Senha para criptografia das sessões iron-session (mínimo 32 caracteres)
# Gere com: openssl rand -base64 32
SESSION_PASSWORD=change-me-use-openssl-rand-base64-32-chars-minimum
